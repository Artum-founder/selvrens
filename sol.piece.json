{
  "spec": "sol-piece/0.1-draft",
  "piece": "selvrens",
  "version": "0.2.0",
  "names": { "no": "Selvrens", "en": "Selvrens" },
  "summary": {
    "no": "Kartlegger ditt digitale jeg: kontoene dine, lekkasjene og det du viser offentlig, og hjelper deg å rydde.",
    "en": "Maps your digital self: your accounts, your leaks and what you show in public, and helps you clean up."
  },
  "kind": "tool",
  "mode": "standalone",
  "home": "https://selvrens.no",
  "license": "AGPL-3.0-only",
  "source": "https://github.com/Artum-founder/selvrens",
  "data": {
    "storage": "local-only",
    "leavesDevice": [
      { "what": "first 5 characters of a SHA-1 password hash", "to": "api.pwnedpasswords.com", "when": "user checks a password" },
      { "what": "email address", "to": "/api/xon-email -> api.xposedornot.com", "when": "user runs the free email check" },
      { "what": "email address", "to": "/api/hibp-email -> haveibeenpwned.com", "when": "user runs the official email check (only if switched on)" },
      { "what": "nothing personal", "to": "/api/breaches", "when": "the public breach catalogue is refreshed" }
    ]
  },
  "ports": {
    "out": [
      { "id": "selvrens.summary", "shape": "Summary", "flow": "summary", "note": "Counts only. No names, logins or domains." },
      { "id": "selvrens.event", "shape": "Event", "flow": "events", "note": "Topic names and counts, never account contents." },
      { "id": "selvrens.pong", "shape": "Health", "flow": "health" }
    ],
    "in": [
      { "id": "selvrens.ping", "requires": ["two-way"] },
      { "id": "selvrens.summary.request", "requires": ["two-way"] },
      { "id": "selvrens.accounts.offer", "shape": "AccountOffer", "requires": ["two-way", "user-consent"], "note": "Another piece offers accounts; the person accepts or declines in Selvrens." }
    ]
  },
  "bonds": {
    "default": "none",
    "directions": ["one-way-out", "two-way", "pass-through"],
    "flows": ["summary", "events", "health"],
    "disconnect": "admin",
    "repair": "lift",
    "transport": "window.postMessage with an exact target origin"
  },
  "shapes": {
    "Summary": {
      "accounts": "number", "breachedServices": "number", "reusedPasswordGroups": "number", "knownLeakedPasswords": "number",
      "markedForDeletion": "number", "deleted": "number", "unreviewed": "number", "publicItems": "number",
      "exposureScore": "number 0-100", "emailChecksWithHits": "number"
    },
    "Event": { "topic": "string", "at": "ISO date", "count": "number (optional)" },
    "Health": { "piece": "string", "version": "string", "ok": "boolean", "checks": "[{ id, ok, detail }]" },
    "AccountOffer": { "accounts": "[{ url | domain, login?, service? }]", "from": "string" }
  },
  "health": { "checks": ["storage", "crypto", "schema", "bonds", "catalogue"] },
  "message": { "envelope": { "sol": "0.1", "piece": "selvrens", "type": "port id", "payload": "shape" } }
}
